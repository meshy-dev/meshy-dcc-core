{
  "schema_version": 2,
  "support": {
    "policy": "long_term_support",
    "minimum_python": "3.7",
    "maximum_tested_python": "3.14",
    "tested_versions": [
      "3.7",
      "3.8",
      "3.9",
      "3.10",
      "3.11",
      "3.12",
      "3.13",
      "3.14"
    ],
    "deprecation": {
      "automatic_calendar_expiry": false,
      "requires_major_release": true,
      "requires_accepted_adr": true,
      "minimum_notice_days": 180
    }
  },
  "build": {
    "pyo3_series": "0.28",
    "native_py37": {
      "python": "3.7",
      "wheel_profile": "native_py37",
      "pr_matrix": [
        {
          "platform": "linux-x86_64",
          "runner": "ubuntu-22.04",
          "target": "x86_64",
          "full_suite": true
        },
        {
          "platform": "windows-x86_64",
          "runner": "windows-2022",
          "target": "x64",
          "full_suite": false
        }
      ]
    },
    "lite_py37": {
      "python": "3.7",
      "wheel_profile": "lite_py37"
    },
    "abi3": {
      "minimum_python": "3.8",
      "feature": "abi3-py38",
      "wheel_profile": "abi3"
    }
  },
  "distributions": {
    "meshy-dcc-core": {
      "pyproject": "pyproject.toml",
      "support_profile": "lts",
      "forbidden_runtime_dependencies": [
        {
          "name": "typing-extensions",
          "from_version": "0.20.22"
        }
      ],
      "wheel_resources": [
        {
          "member": "meshy_dcc_core/schemas/adapter-install-sop-v1.schema.json",
          "source": "python/meshy_dcc_core/schemas/adapter-install-sop-v1.schema.json",
          "canonical_url": "https://www.meshy.ai/meshy-dcc/schemas/adapter-install-sop-v1.schema.json",
          "sha256": "78271120374b0e23e47097de168d99a025671d913454884d28cf650bbc10a10f",
          "status": "frozen"
        },
        {
          "member": "meshy_dcc_core/schemas/adapter-install-sop-v2.schema.json",
          "source": "python/meshy_dcc_core/schemas/adapter-install-sop-v2.schema.json",
          "canonical_url": "https://www.meshy.ai/meshy-dcc/schemas/adapter-install-sop-v2.schema.json",
          "sha256": "71df77f27399d8017d43393f0376c154a8b9bd4700f38098ed66b91a33eb9275",
          "status": "current"
        }
      ]
    },
    "meshy-dcc-core-semantic": {
      "pyproject": "pkg/meshy-dcc-core-semantic/pyproject.toml",
      "support_profile": "lts"
    }
  },
  "optional_dependencies": {
    "semantic": {
      "owner_distribution": "meshy-dcc-core",
      "native_dependency": "meshy-dcc-core-semantic",
      "python_fallback_dependency": "fastembed",
      "fallback_minimum_python": "3.8"
    }
  },
  "wheel_profiles": {
    "native_py37": {
      "distribution": "meshy-dcc-core",
      "wheel_tag": "cp37-cp37m",
      "root_is_purelib": false,
      "extension_module": "meshy_dcc_core/_core",
      "expects_extension": true,
      "platforms": {
        "linux-x86_64": {
          "allowed_platform_tags": [
            "manylinux_2_17_x86_64",
            "manylinux2014_x86_64"
          ]
        },
        "windows-x86_64": {
          "allowed_platform_tags": [
            "win_amd64"
          ]
        }
      }
    },
    "lite_py37": {
      "distribution": "meshy-dcc-core",
      "wheel_tag": "py3-none",
      "root_is_purelib": true,
      "extension_module": "meshy_dcc_core/_core",
      "expects_extension": false,
      "platforms": {
        "any": {
          "allowed_platform_tags": [
            "any"
          ]
        }
      }
    },
    "abi3": {
      "distribution": "meshy-dcc-core",
      "wheel_tag": "cp38-abi3",
      "root_is_purelib": false,
      "extension_module": "meshy_dcc_core/_core",
      "expects_extension": true,
      "platforms": {
        "linux-x86_64": {
          "allowed_platform_tags": [
            "manylinux_2_17_x86_64",
            "manylinux2014_x86_64"
          ]
        },
        "windows-x86_64": {
          "allowed_platform_tags": [
            "win_amd64"
          ]
        },
        "macos-universal2": {
          "required_platform_tag_patterns": [
            "macosx_*_universal2"
          ],
          "allowed_platform_tag_patterns": [
            "macosx_*_universal2",
            "macosx_*_x86_64",
            "macosx_*_arm64"
          ]
        },
        "macos-native": {
          "allowed_platform_tag_patterns": [
            "macosx_*_x86_64",
            "macosx_*_arm64"
          ]
        }
      }
    },
    "semantic_native_py37": {
      "distribution": "meshy-dcc-core-semantic",
      "wheel_tag": "cp37-cp37m",
      "root_is_purelib": false,
      "extension_module": "meshy_dcc_core_semantic/_native",
      "expects_extension": true,
      "platforms": {
        "linux-x86_64": {
          "allowed_platform_tags": [
            "manylinux_2_28_x86_64"
          ]
        },
        "windows-x86_64": {
          "allowed_platform_tags": [
            "win_amd64"
          ]
        }
      }
    },
    "semantic_abi3": {
      "distribution": "meshy-dcc-core-semantic",
      "wheel_tag": "cp38-abi3",
      "root_is_purelib": false,
      "extension_module": "meshy_dcc_core_semantic/_native",
      "expects_extension": true,
      "platforms": {
        "linux-x86_64": {
          "allowed_platform_tags": [
            "manylinux_2_28_x86_64"
          ]
        },
        "windows-x86_64": {
          "allowed_platform_tags": [
            "win_amd64"
          ]
        },
        "macos-native": {
          "allowed_platform_tag_patterns": [
            "macosx_*_arm64"
          ]
        }
      }
    }
  },
  "projections": {
    "requires_python_globs": [
      "*.md",
      "AGENTS.md",
      "AI_AGENT_GUIDE.md",
      "CONTRIBUTING.md",
      "llms.txt",
      "llms-full.txt",
      "docs/**/*.md",
      "skills/**/SKILL.md"
    ],
    "requires_python_exemptions": [
      "docs/guide/new-adapter-onboarding.md"
    ],
    "calendar_policy_globs": [
      "AGENTS.md",
      "AI_AGENT_GUIDE.md",
      "CONTRIBUTING.md",
      "llms.txt",
      "llms-full.txt",
      "docs/**/*.md",
      "skills/**/SKILL.md",
      ".github/workflows/*.yml"
    ]
  },
  "runtime_smoke": {
    "native_py37": [
      "meshy_dcc_core",
      "meshy_dcc_core._core",
      "meshy_dcc_core.skill",
      "meshy_dcc_core.schema",
      "meshy_dcc_core.server_base",
      "meshy_dcc_core.host",
      "meshy_dcc_core._server.options",
      "meshy_dcc_core._runtime.mcp_http_config"
    ],
    "lite_py37": [
      "meshy_dcc_core",
      "meshy_dcc_core.skill",
      "meshy_dcc_core.schema",
      "meshy_dcc_core.server_base",
      "meshy_dcc_core.host",
      "meshy_dcc_core._lite_fallback",
      "meshy_dcc_core._runtime.mcp_http_config",
      "meshy_dcc_core._runtime.pure_skill_catalog",
      "meshy_dcc_core._runtime.server_factory",
      "meshy_dcc_core._runtime.sidecar_skill_server"
    ]
  },
  "test_toolchain": {
    "jsonschema_py37": "4.17.3",
    "pytest": "7.4.4",
    "pytest_xdist": "3.5.0",
    "typing_extensions": "4.7.1"
  }
}
