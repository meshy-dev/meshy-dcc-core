{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReleaseFiles",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::meshy-cdn/meshy-dcc-core/*"
    },
    {
      "Sid": "ListReleasePrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::meshy-cdn",
      "Condition": { "StringLike": { "s3:prefix": ["meshy-dcc-core/*"] } }
    },
    {
      "Sid": "NpmToken",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:us-west-2:133081291590:secret:meshy-dcc/release/npm-token-*"
    }
  ]
}
